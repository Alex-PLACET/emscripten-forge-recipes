+
+double GetDevicePixelRatio()
+{
+    return emscripten_get_device_pixel_ratio();
+}
+
+int GetScreenWidth()
+{
+    return EM_ASM_INT({
+        return mainWindow.offsetWidth;
+    });
+}
+
