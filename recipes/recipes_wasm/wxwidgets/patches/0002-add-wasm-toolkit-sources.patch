+        case WXK_F3:
+        case WXK_F4:
+        case WXK_F5:
+        case WXK_F6:
+        case WXK_F7:
+        case WXK_F8:
+        case WXK_F9:
+        case WXK_F10:
+        case WXK_F11:
+        case WXK_F12:
+        case WXK_F13:
+        case WXK_F14:
+        case WXK_F15:
+        case WXK_F16:
+        case WXK_F17:
+        case WXK_F18:
+        case WXK_F19:
+        case WXK_F20:
+        case WXK_F21:
+        case WXK_F22:
+        case WXK_F23:
+        case WXK_F24:
+            // case WXK_SELECT: ??
+            // case WXK_EXECUTE: ??
