+bool wxWasmDCImpl::DoBlit(wxCoord xdest, wxCoord ydest,
+                          wxCoord width, wxCoord height,
+                          wxDC *source,
+                          wxCoord xsrc, wxCoord ysrc,
+                          wxRasterOperationMode WXUNUSED(rop),
