+/////////////////////////////////////////////////////////////////////////////
+// Name:        wx/wasm/dataobj.cpp
+// Purpose:     wxDataObject implementation
+// Author:      Adam Hilss
+// Copyright:   (c) 2022 Adam Hilss
+// Licence:     LGPL v2
