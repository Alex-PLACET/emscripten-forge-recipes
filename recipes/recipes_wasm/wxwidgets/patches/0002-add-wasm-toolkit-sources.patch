+    {"CapsLock", WXK_CAPITAL},
+    {"ControlLeft", WXK_CONTROL},
+    {"ControlRight", WXK_CONTROL},
+    {"OSLeft", WXK_CONTROL},
+    {"OSRight", WXK_CONTROL},
+    {"MetaLeft", WXK_CONTROL},
+    {"MetaRight", WXK_CONTROL},
+    {"ShiftLeft", WXK_SHIFT},
