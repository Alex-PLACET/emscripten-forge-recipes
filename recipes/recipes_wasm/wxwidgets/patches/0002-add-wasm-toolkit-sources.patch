+{
+    {"Digit1", '1'},
+    {"Digit2", '2'},
+    {"Digit3", '3'},
+    {"Digit4", '4'},
+    {"Digit5", '5'},
+    {"Digit6", '6'},
+    {"Digit7", '7'},
+    {"Digit8", '8'},
+    {"Digit9", '9'},
+    {"Digit0", '0'},
+    {"KeyA", 'A'},
+    {"KeyB", 'B'},
+    {"KeyC", 'C'},
+    {"KeyD", 'D'},
+    {"KeyE", 'E'},
+    {"KeyF", 'F'},
+    {"KeyG", 'G'},
+    {"KeyH", 'H'},
+    {"KeyI", 'I'},
+    {"KeyJ", 'J'},
+    {"KeyK", 'K'},
+    {"KeyL", 'L'},
+    {"KeyM", 'M'},
+    {"KeyN", 'N'},
+    {"KeyO", 'O'},
+    {"KeyP", 'P'},
+    {"KeyQ", 'Q'},
+    {"KeyR", 'R'},
+    {"KeyS", 'S'},
+    {"KeyT", 'T'},
+    {"KeyU", 'U'},
+    {"KeyV", 'V'},
+    {"KeyW", 'W'},
+    {"KeyX", 'X'},
+    {"KeyY", 'Y'},
+    {"KeyZ", 'Z'},
+    {"Comma", ','},
+    {"Period", '.'},
+    {"Semicolon", ';'},
+    {"Quote", '\''},
+    {"BracketLeft", '['},
+    {"BracketRight", ']'},
+    {"Backquote", '`'},
