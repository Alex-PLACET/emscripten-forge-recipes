@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/imgui-targets.cmake")

set(imgui_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set(imgui_LIBRARIES imgui::imgui)
set(imgui_BACKENDS_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/imgui/backends")
set(imgui_VERSION "@PROJECT_VERSION@")

set(imgui_FOUND TRUE)
